# syntax=docker/dockerfile:1

# glibc, not Alpine. @node-rs/argon2 resolves a prebuilt platform binary at
# install time; on this base that is linux-x64-gnu, which exists for every
# published version. On musl the optional dependency is not always published,
# and the failure surfaces as a require() error at boot rather than as a build
# failure here.
FROM node:22-bookworm-slim AS deps

WORKDIR /app

# Only the manifest, so the install layer stays cached until a dependency
# actually changes. There is no lockfile in this package — it is normally
# installed by the monorepo's yarn — so this is `npm install`, not `npm ci`.
COPY package.json ./

# --omit=dev drops vitest and socket.io-client. Only the *.spec.ts files need
# them, and .dockerignore keeps those out of the build context.
RUN npm install --omit=dev --no-audit --no-fund \
 && npm cache clean --force


FROM node:22-bookworm-slim AS runtime

# Defaults, all three overridden by compose. They are here so the image runs on
# its own, and so a missing compose entry fails loudly rather than silently.
ENV NODE_ENV=production \
    CHESS_SYNC_HOST=0.0.0.0 \
    CHESS_SYNC_PORT=3010 \
    CHESS_SYNC_DATA_DIR=/data

WORKDIR /app

COPY --from=deps /app/node_modules ./node_modules
COPY package.json ./
COPY src ./src

# /data is a mount point. Creating it with the right owner here is what makes
# an empty volume come up owned by `node`; with a bind mount the host's
# ownership wins and has to be set there instead.
RUN mkdir -p /data && chown node:node /data

# setBlob uses the client-supplied filename as a path component unchecked, so
# this process can be made to write wherever it is allowed to write. uid 1000
# is a far smaller blast radius than root.
USER node

# Documentation only. Nothing publishes this to the host.
EXPOSE 3010

# Node 22 ships global fetch, so the image needs no curl or wget. start-period
# is generous because PGlite opens the database before /health answers, and an
# unhealthy container aborts the compose deploy.
HEALTHCHECK --interval=30s --timeout=5s --start-period=60s --retries=5 \
  CMD ["node", "-e", "fetch('http://127.0.0.1:3010/health').then(r=>process.exit(r.ok?0:1),()=>process.exit(1))"]

# Exec form, so PID 1 is node and Docker's SIGTERM reaches the handler in
# cli.ts directly. `--import tsx` rather than the tsx CLI for the same reason:
# the CLI spawns node as a child, and the signal would stop at the wrapper
# while PGlite still holds the database open.
CMD ["node", "--import", "tsx", "src/cli.ts"]
