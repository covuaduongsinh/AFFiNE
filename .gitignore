storageState.json
/.understand-anything

# self-hosted server state: postgres data, blob storage, generated config
/.docker/selfhost/data/
/.docker/selfhost/config/

# @chess/sync runtime state: PGlite database, uploaded blobs, JWT secret.
# `./data/chess-sync` is the default when CHESS_SYNC_DATA_DIR is unset, and it
# lands wherever the process happened to be started from. Not a bare `data/`:
# tracked files live under directories of that name elsewhere in the tree.
/data/chess-sync/
packages/chess/sync/data/

# Vendored Arasan binaries (scripts/fetch-arasan.mjs)
packages/frontend/apps/electron/resources/arasan/*.exe
packages/frontend/apps/electron/resources/arasan/*.nnue

# local test/browser artifacts
/.playwright-browsers/
**/.vitest-attachments/
/blocksuite/framework/std/src/__tests__/gfx/__screenshots__/
